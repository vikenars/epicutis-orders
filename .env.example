# ──────────────────────────────────────────────────────────────────────────────
# Epicutis Orders — environment variables
#
# Copy to .env (NEVER commit .env) and fill in real values for local dev.
# In production (Railway / Render), set these in the platform's secret store.
# Never hardcode secrets in source.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ── Shopify Admin API ────────────────────────────────────────────────────────
# The store domain — e.g. "new-epicutis.myshopify.com" (no protocol).
SHOPIFY_STORE_DOMAIN=

# Preferred: a long-lived Shopify admin access token. If set, it is used
# directly for all admin GraphQL calls.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Alternative: public-app client credentials. Used only if
# SHOPIFY_ADMIN_ACCESS_TOKEN is empty. The server exchanges these for a
# short-lived access token via /admin/oauth/access_token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional override for the Shopify Admin API version. Defaults to 2024-01.
# SHOPIFY_API_VERSION=2024-01

# ── Email-OTP authentication ─────────────────────────────────────────────────
# Resend API key for delivering 6-digit sign-in codes.
# REQUIRED in production. In development, leave empty to log codes to console.
RESEND_API_KEY=

# Optional: override the OTP "from" address (must be a verified Resend sender).
# OTP_FROM_ADDRESS=Epicutis Orders <onboarding@resend.dev>

# Optional: a reply-to header on OTP emails.
# OTP_REPLY_TO=

# ── Zoho Books (salesperson source of truth) ─────────────────────────────────
# Live Shopify orders don't carry a parseable salesperson value (note / tags /
# customAttributes / order metafields are empty for the rep, and `staffMember`
# requires the read_users scope we don't have). They DO carry Zoho cross-refs
# in their custom metafields, so the server resolves the rep via Zoho Books:
#   custom.zoho_invoice                 → Zoho Books invoice number
#   custom.zoho_order_reference_number  → Zoho Books sales-order number
# Zoho exposes `salesperson_name` on both, and we cache resolutions in-memory
# with a TTL so a search stays responsive.
#
# Optional. Only populates the admin/RSD-only salesperson column — order
# visibility does not depend on it. Without these the column is just empty.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Long-lived refresh token from the Zoho self-client flow. Either name works;
# ZOHO_BOOKS_REFRESH_TOKEN matches the sales-dashboard project's convention.
ZOHO_BOOKS_REFRESH_TOKEN=
# ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Optional. Default https://accounts.zoho.com (US). Use the regional accounts
# host if your tenant is in another DC: .eu / .in / .com.au / .jp.
# ZOHO_ACCOUNTS_BASE=
# Optional. Default https://www.zohoapis.com/books/v3 (US). Use the regional
# Books host if your tenant is in another DC.
# ZOHO_BOOKS_BASE=

# ── Role-based access control ────────────────────────────────────────────────
# Every authenticated user can see and search all orders. Role only controls
# the admin/RSD-only salesperson field and the diagnostics endpoints.
#
#   BLOCKED_EMAILS — comma-separated denylist, enforced ahead of everything
#   else. A blocked email cannot request or verify an OTP (403 "This account
#   has been disabled") and any session token already issued to it stops
#   working on its next request. Matched case-insensitively. Use this to fully
#   revoke access for a user regardless of domain or role.
# BLOCKED_EMAILS=abitter@epicutis.com
#
#   ADMIN_EMAILS — comma-separated allowlist of admin emails. Admins see the
#   salesperson field and the diagnostics endpoints. If unset, a built-in
#   default list is used (see server/auth.ts).
# ADMIN_EMAILS=alice@epicutis.com,bob@signumbio.com
#
#   RSD_EMAILS — comma-separated emails granted the RSD role, same as admin.
# RSD_EMAILS=
